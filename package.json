{
  "name": "jeongyeon-ielts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-vocabulary-manifest.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-vocabulary-manifest.mjs && tsc && vite build",
    "test": "vitest run src",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:production": "npm run build && node scripts/check-production.mjs",
